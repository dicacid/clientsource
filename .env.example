# Redis-compatible datastore.
REDIS_URL=redis://localhost:6379

# Separate application namespace when sharing a Redis instance.
STATE_KEY=spa-intelligence:state:v1

# Use at least 32 random bytes. Never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-characters
SPA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-secret

# Optional deployment fallback. Brett can instead connect his own key in AI & Models.
OPENROUTER_API_KEY=

# Optional Render Cron Job configuration for unattended tender scans.
# The same strong secret must be set on both the web service and cron job.
TENDER_CRON_SECRET=
TENDER_SCAN_URL=https://spa-intelligence.onrender.com/api/tenders/cron
